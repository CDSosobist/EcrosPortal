# ---------------------------------------------------------------------------
# Общие настройки портала
# ---------------------------------------------------------------------------
PORTAL_SITE_NAME=Портал ЭКРОСХИМ
PORTAL_COMPANY_NAME=ЭКРОСХИМ
PORTAL_SUPPORT_EMAIL=portal@example.local
DJANGO_TIME_ZONE=Europe/Moscow

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,portal.example.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.local

# ---------------------------------------------------------------------------
# База данных
#   sqlite    — файл var/db.sqlite3, подходит для пилота и до ~500 сотрудников
#   postgres  — PostgreSQL (рекомендуется для боевой эксплуатации)
# ---------------------------------------------------------------------------
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_PATH=/opt/ecros-portal/var/db.sqlite3
# DJANGO_DB_ENGINE=postgres
# DJANGO_DB_NAME=ecros_portal
# DJANGO_DB_USER=ecros
# DJANGO_DB_PASSWORD=change-me
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# ---------------------------------------------------------------------------
# Active Directory (on-prem, LDAP/LDAPS)
#   AD_PROVIDER=ldap — боевой каталог
#   AD_PROVIDER=mock — демонстрационный генератор на 400 сотрудников
#   Если AD_SERVER пуст, портал автоматически работает на демо-каталоге.
# ---------------------------------------------------------------------------
AD_ENABLED=True
AD_PROVIDER=ldap
AD_SERVER=dc01.ecros.local
AD_PORT=636
AD_USE_SSL=True
AD_VERIFY_TLS=False
# AD_CA_CERT_FILE=/etc/ssl/certs/ecros-root-ca.pem
AD_START_TLS=False
AD_BASE_DN=DC=ecros,DC=local
AD_USER_SEARCH_BASE=OU=Сотрудники,DC=ecros,DC=local
AD_GROUP_SEARCH_BASE=OU=Groups,DC=ecros,DC=local
AD_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(isCriticalSystemObject=TRUE)))
AD_BIND_DN=CN=svc-portal,OU=Service Accounts,DC=ecros,DC=local
AD_BIND_PASSWORD=change-me
AD_DOMAIN_NETBIOS=ECROS
AD_TIMEOUT=12
AD_PAGE_SIZE=500
AD_SYNC_INTERVAL_MINUTES=60

# Аварийный вход по локальному паролю (служебные учётные записи)
PORTAL_ALLOW_LOCAL_PASSWORD=True
PORTAL_LOGIN_MAX_ATTEMPTS=8
PORTAL_LOGIN_LOCKOUT_SECONDS=900
DJANGO_SESSION_COOKIE_AGE=36000

# ---------------------------------------------------------------------------
# Отпуска
# ---------------------------------------------------------------------------
VACATION_DEFAULT_DAYS=28
VACATION_MAX_DAYS_PER_REQUEST=28
VACATION_MIN_NOTICE_DAYS=3
VACATION_MAX_OVERLAP_PERCENT=40

# ---------------------------------------------------------------------------
# Уведомления по электронной почте
# ---------------------------------------------------------------------------
PORTAL_NOTIFY_BY_EMAIL=False
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.ecros.local
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=portal@ecros.local

# ---------------------------------------------------------------------------
# Безопасность в боевом режиме (за HTTPS)
# ---------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
