# Портал ЭКРОСХИМ: nginx перед Gunicorn
# sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ecros-portal

upstream ecros_portal {
    server 127.0.0.1:8000 fail_timeout=0;
}

server {
    listen 80;
    server_name portal.ecros.local;
    # HTTP -> HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name portal.ecros.local;

    ssl_certificate     /etc/ssl/certs/ecros-portal.crt;
    ssl_certificate_key /etc/ssl/private/ecros-portal.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 20m;
    keepalive_timeout 65;

    access_log /var/log/nginx/ecros-portal.access.log;
    error_log  /var/log/nginx/ecros-portal.error.log;

    # статика Django
    location /static/ {
        alias /opt/ecros-portal/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    location /media/ {
        alias /opt/ecros-portal/var/media/;
        access_log off;
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 90;
        proxy_pass http://ecros_portal;
    }

    # health-check без логирования
    location = /healthz/ {
        access_log off;
        proxy_pass http://ecros_portal;
    }
}
